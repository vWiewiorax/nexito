# Publiczny adres strony (canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://twojadomena.pl
# Opcjonalny webhook (np. Make, Zapier, n8n, Slack), na który trafiają zgłoszenia z formularza
CONTACT_WEBHOOK_URL=
# Cloudflare Turnstile (captcha w formularzu). Bez tych kluczy formularz w produkcji nie wyśle wiadomości
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
